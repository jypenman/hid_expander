{
 "kind": "hid-expander-addition",
 "version": 1,
 "name": "macOS shortcuts on Windows",
 "created": "2026-07-28",
 "description": "Mirror image of the Windows-on-macOS set: keep using Mac muscle memory (Cmd+C, Cmd+Q, Cmd+Left, Option+Left) while the Windows host receives its native equivalents (Ctrl+C, Alt+F4, Home, Ctrl+Left). Implemented with modifier-chords, so no Ctrl/Cmd key swap is needed and every other use of Cmd/Option passes through untouched. Applies on Windows only.",
 "requires": {
  "engine": "mod_chords support (s2_mapping.mod_chord / s6 _run_mod_chord)"
 },

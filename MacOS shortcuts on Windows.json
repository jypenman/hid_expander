{
 "kind": "hid-expander-addition",
 "version": 2,
 "name": "macOS shortcuts on Windows",
 "created": "2026-07-28",
 "description": "Use Mac muscle memory on a Windows host. Works in two layers: (1) a MODIFIER SWAP (Cmd<->Ctrl) so every Cmd+letter shortcut becomes its Ctrl equivalent natively -- correct hold, repeat and timing, no per-key rewriting; (2) a short list of chords for the cases a swap can't express, such as Cmd+Tab -> Alt+Tab which must keep the modifier HELD so the app switcher stays open. Shift is passed through to those held rules, so Cmd+Shift+Tab cycles backwards. Windows only. NOTE: after the swap your physical Ctrl sends Cmd/Win, so if you use the window-move chord set it to match (OS tab -> Window mode).",
 "requires": {
  "engine": "mod_remap + mod_chords with holdmods (19.2 BF3 or later)"
 },
 "entries": [
  {
   "scope": "modremap",
   "os": "win",
   "map": {
    "8": 1,
    "1": 8
   },
   "note": "Swap Cmd/Win <-> Ctrl on Windows. This alone makes Cmd+C/V/X/Z/A/S/F/T/W/N/P/... work, with correct hold behaviour."
  },
  {
   "scope": "modchord",
   "layer": -1,
   "mods": 1,
   "id": 43,
   "action": [
    "holdmods",
    4,
    43
   ],
   "os": "win",
   "note": "Cmd+Tab -> Alt+Tab, held: keep Cmd down and tap Tab to cycle; add Shift to cycle backwards"
  },
  {
   "scope": "modchord",
   "layer": -1,
   "mods": 1,
   "id": 53,
   "action": [
    "holdmods",
    1,
    43
   ],
   "os": "win",
   "note": "Cmd+` -> Ctrl+Tab, held: cycle TABS within the current app (add Shift to go backwards)"
  },
  {
   "scope": "modchord",
   "layer": -1,
   "mods": 1,
   "id": 20,
   "action": [
    "keymods",
    61,
    4
   ],
   "os": "win",
   "note": "Cmd+Q (quit app) -> Alt+F4"
  },
